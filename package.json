{
  "name": "@nerva/feedback-widget",
  "version": "0.2.0",
  "description": "Embeddable feedback button, modal and session recorder for Nerva feedback projects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/global.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build:js": "node build.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run check",
    "test": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@rrweb/rrweb-plugin-console-record": "^2.1.6",
    "@rrweb/rrweb-plugin-network-record": "^2.1.6",
    "rrweb": "^2.1.6"
  },
  "peerDependencies": {
    "html2canvas": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "playwright": "^1.60.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "feedback",
    "session-replay",
    "rrweb",
    "widget",
    "nerva"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saparothRob/feedback-widget.git"
  }
}
